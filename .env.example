# Supabase: usa la publishable key nueva o la anon key legacy.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# VITE_SUPABASE_ANON_KEY=eyJ...

# Activar solo tras aplicar las migraciones y verificar Auth/SMTP/redirects.
VITE_PORTFOLIO_CLOUD_ENABLED=false


# Origen canónico de PRO para sitemap/robots. PRE y previews no se indexan.
FREEWALLET_SITE_URL=https://freewallet-gilt.vercel.app
# En un proyecto PRE independiente, además de la detección de release/preview:
# FREEWALLET_DEPLOYMENT_ENV=preproduction
