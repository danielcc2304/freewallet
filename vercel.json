{
    "routes": [
        {
            "src": "/__market/yahoo1/(.*)",
            "dest": "https://query1.finance.yahoo.com/$1"
        },
        {
            "src": "/__market/yahoo2/(.*)",
            "dest": "https://query2.finance.yahoo.com/$1"
        },
        {
            "src": "/__finect/api/(.*)",
            "dest": "https://api.finect.com/$1"
        },
        {
            "src": "/__finect/site/(.*)",
            "dest": "https://www.finect.com/$1"
        },
        {
            "src": "/__holdings/spy",
            "dest": "https://www.ssga.com/us/en/intermediary/library-content/products/fund-data/etfs/us/holdings-daily-us-en-spy.xlsx"
        },
        {
            "src": "/__holdings/sp500-sectors",
            "dest": "https://en.wikipedia.org/wiki/List_of_S%26P_500_companies"
        },
        {
            "src": "/__holdings/urth",
            "dest": "https://www.ishares.com/us/products/239696/ishares-msci-world-etf/latest-holdings.csv"
        },
        {
            "src": "/__holdings/eem",
            "dest": "https://www.ishares.com/us/products/239637/ishares-msci-emerging-markets-etf/latest-holdings.csv"
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ]
}
